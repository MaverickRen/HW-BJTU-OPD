+    """Align a privileged teacher's response distributions to student positions.
+
+    ``extract_prompt_logprobs`` drops the undefined first-token distribution
+    and appends one dummy row at the end.  Consequently, for a teacher prompt
+    of length ``q`` and a response of length ``r``, the distributions which
+    predict the response live at ``[q - 1 : q + r - 1]``.  Student losses are
+    read from the analogous ``[p - 1 : p + r - 1]`` interval.  Privileged
+    images can change ``q`` by thousands of visual tokens, so an absolute copy
+    would silently compare the wrong positions.
+
+    Prompt and terminal rows are filled with dummies because the response mask
+    excludes them from the distillation loss.
+    """
+    for name, value in (
+        ("teacher_prompt_length", teacher_prompt_length),
+        ("student_prompt_length", student_prompt_length),
+        ("response_length", response_length),
+    ):
+        if not isinstance(value, int) or isinstance(value, bool):
+            raise TypeError(f"{name} must be an integer, got {type(value).__name__}")
+    if teacher_prompt_length <= 0 or student_prompt_length <= 0:
+        raise ValueError("Teacher and student prompts must both contain at least one token")
+    if response_length < 0:
+        raise ValueError("response_length must be non-negative")
+    if teacher_ids.ndim != 2 or teacher_logprobs.ndim != 2:
+        raise ValueError(
+            "Teacher ids/logprobs must both have shape [sequence, distribution_width]"
+        )
+    if teacher_ids.shape != teacher_logprobs.shape:
+        raise ValueError(
+            f"Teacher ids/logprobs shape mismatch: {teacher_ids.shape} != {teacher_logprobs.shape}"
+        )
+    expected_teacher_length = teacher_prompt_length + response_length
+    if teacher_ids.shape[0] != expected_teacher_length:
+        raise ValueError(
+            "Teacher output length differs from rebuilt prompt plus response: "
+            f"{teacher_ids.shape[0]} != {teacher_prompt_length} + {response_length}"
+        )
+
+    student_sequence_length = student_prompt_length + response_length
+    aligned_ids = torch.zeros(
+        (student_sequence_length, teacher_ids.shape[1]),
+        dtype=teacher_ids.dtype,
+        device=teacher_ids.device,
+    )
+    aligned_logprobs = torch.zeros(
+        (student_sequence_length, teacher_logprobs.shape[1]),
+        dtype=teacher_logprobs.dtype,
+        device=teacher_logprobs.device,
+    )
+    if response_length:
+        teacher_start = teacher_prompt_length - 1
+        student_start = student_prompt_length - 1
