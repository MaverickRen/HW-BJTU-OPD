+def validate_role_gpu_partition(
+    observations: Sequence[Mapping[str, Any]],
+    *,
+    student_physical_gpus: Sequence[int],
+    teacher_physical_gpus: Sequence[int],
+    require_gpu_uuid: bool = False,
+) -> dict[str, Any]:
+    """Validate a strict student/teacher physical-GPU partition.
+
+    This function is deliberately independent of Ray and CUDA so that the
+    admission contract can be tested on CPU.  The worker-side probe supplies
+    the observations; this function only validates and normalizes them.
+    """
+
+    def _expected(values: Sequence[int], label: str) -> tuple[int, ...]:
+        if not isinstance(values, (list, tuple)) or not values:
+            raise ValueError(f"{label} physical GPU partition must be a non-empty list")
+        if any(type(value) is not int or value < 0 for value in values):
+            raise ValueError(f"{label} physical GPU partition must contain non-negative integers")
+        if len(set(values)) != len(values):
+            raise ValueError(f"{label} physical GPU partition contains duplicates")
+        return tuple(values)
+
+    expected = {
+        "student": _expected(student_physical_gpus, "student"),
+        "teacher": _expected(teacher_physical_gpus, "teacher"),
+    }
+    if set(expected["student"]) & set(expected["teacher"]):
+        raise ValueError("student and teacher physical GPU partitions overlap")
+
+    normalized: list[dict[str, Any]] = []
+    seen_physical: set[int] = set()
+    seen_uuids: set[str] = set()
+    for observation in observations:
+        if not isinstance(observation, Mapping):
+            raise ValueError("GPU observation must be a mapping")
+        role = observation.get("role")
+        if role not in expected:
+            raise ValueError(f"unknown GPU observation role: {role!r}")
+        rank = observation.get("rank")
+        if type(rank) is not int or rank < 0:
+            raise ValueError("GPU observation rank must be a non-negative integer")
+        pid = observation.get("pid")
+        if type(pid) is not int or pid <= 0:
+            raise ValueError("GPU observation pid must be a positive integer")
+        node_id = observation.get("node_id")
+        if not isinstance(node_id, str) or not node_id:
+            raise ValueError("GPU observation node_id must be a non-empty string")
+
+        ray_ids = observation.get("ray_accelerator_ids")
+        if not isinstance(ray_ids, (list, tuple)) or len(ray_ids) != 1 or not isinstance(ray_ids[0], str):
+            raise ValueError("GPU observation must have one Ray accelerator ID")
+        ray_id = ray_ids[0]
+        if not ray_id.isdigit():
+            raise ValueError("Ray accelerator ID must be a numeric physical index")
+        if str(int(ray_id)) != ray_id:
+            raise ValueError("Ray accelerator ID must use canonical decimal notation")
+        physical_gpu = int(ray_id)
+
+        visible_devices = observation.get("cuda_visible_devices")
+        if not isinstance(visible_devices, str):
+            raise ValueError("CUDA visible devices must be a string")
+        if visible_devices != ray_id:
+            raise ValueError("Ray ID and CUDA visibility must identify the same one GPU")
+
+        if physical_gpu in seen_physical:
+            raise ValueError("physical GPU assignments are not unique")
+        seen_physical.add(physical_gpu)
+
+        gpu_uuid = observation.get("gpu_uuid")
+        if require_gpu_uuid and (not isinstance(gpu_uuid, str) or not gpu_uuid):
+            raise ValueError("GPU UUID is required")
+        if gpu_uuid is not None:
+            if not isinstance(gpu_uuid, str) or not gpu_uuid:
+                raise ValueError("GPU UUID must be a non-empty string")
+            if gpu_uuid in seen_uuids:
+                raise ValueError("GPU UUIDs are not unique")
+            seen_uuids.add(gpu_uuid)
+
+        normalized.append(
+            {
+                "role": role,
+                "rank": rank,
+                "pid": pid,
+                "node_id": node_id,
+                "ray_accelerator_ids": [ray_id],
+                "cuda_visible_devices": ray_id,
+                "physical_gpu": physical_gpu,
+                "gpu_uuid": gpu_uuid,
+            }
+        )
+
+    required_count = len(expected["student"]) + len(expected["teacher"])
+    if len(normalized) != required_count:
+        raise ValueError(f"expected {required_count} GPU observations, got {len(normalized)}")
+    nodes = {record["node_id"] for record in normalized}
+    if len(nodes) != 1:
+        raise ValueError("student and teacher GPU workers must be on one node")
+
+    for role, physical_gpus in expected.items():
+        role_records = [record for record in normalized if record["role"] == role]
+        if {record["physical_gpu"] for record in role_records} != set(physical_gpus):
+            raise ValueError(f"{role} physical GPU partition does not match expected GPUs")
+        if sorted(record["rank"] for record in role_records) != list(range(len(physical_gpus))):
+            raise ValueError(f"{role} GPU ranks are not contiguous and unique")
+        physical_gpu_by_rank = {
+            record["rank"]: record["physical_gpu"] for record in role_records
+        }
+        if physical_gpu_by_rank != dict(enumerate(physical_gpus)):
+            raise ValueError(f"{role} rank-to-physical-GPU mapping does not match expected GPUs")
+
+    role_order = {"student": 0, "teacher": 1}
+    normalized.sort(key=lambda record: (role_order[record["role"]], record["rank"]))
+    return {
+        "node_id": next(iter(nodes)),
+        "expected": {"student": list(expected["student"]), "teacher": list(expected["teacher"])},
+        "observations": normalized,
+    }
