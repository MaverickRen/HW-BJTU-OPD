+def _fsync_directory(path: str) -> None:
+    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
+    try:
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+
+
+def _fsync_tree(path: str) -> None:
+    """Durably flush a completed checkpoint tree and reject symlink aliases."""
+    directories = []
+    for root, dirnames, filenames in os.walk(path):
+        directories.append(root)
+        for name in dirnames + filenames:
+            entry = os.path.join(root, name)
+            if os.path.islink(entry):
+                raise RuntimeError(f"Checkpoint tree contains a symlink: {entry}")
+        for filename in filenames:
+            descriptor = os.open(os.path.join(root, filename), os.O_RDONLY)
+            try:
+                os.fsync(descriptor)
+            finally:
+                os.close(descriptor)
+    for directory in reversed(directories):
+        _fsync_directory(directory)
+
+
+def _atomic_write_bytes(path: str, payload: bytes) -> None:
+    """Durably replace a small commit/metadata file on the same filesystem."""
+    parent = os.path.dirname(path)
+    os.makedirs(parent, exist_ok=True)
+    temporary = os.path.join(parent, f".{os.path.basename(path)}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
+    try:
+        with open(temporary, "xb") as handle:
+            handle.write(payload)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, path)
+        _fsync_directory(parent)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
