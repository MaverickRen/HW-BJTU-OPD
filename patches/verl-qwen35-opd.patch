+
+
+def _write_role_gpu_partition_receipt(path: str, document: dict[str, Any]) -> dict[str, Any]:
+    """Publish one private, create-once, durably sealed role-GPU receipt."""
+    if not os.path.isabs(path):
+        raise RuntimeError("role GPU partition receipt path must be absolute")
+    parent = os.path.dirname(path)
+    if not os.path.isdir(parent):
+        raise RuntimeError(f"role GPU partition receipt directory is unavailable: {parent}")
+    seal = hashlib.sha256(_canonical_json_bytes(document)).hexdigest()
+    complete = {**document, "seal_sha256": seal}
+    raw = _canonical_json_bytes(complete) + b"\n"
+    temporary = os.path.join(parent, f".{os.path.basename(path)}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
+    descriptor = None
+    created_temporary = False
+    try:
+        descriptor = os.open(
+            temporary,
+            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
+            0o600,
+        )
+        created_temporary = True
+        with os.fdopen(descriptor, "wb") as handle:
+            descriptor = None
+            handle.write(raw)
+            handle.flush()
+            os.fchmod(handle.fileno(), 0o600)
+            os.fsync(handle.fileno())
+        # Hard-link publication is atomic and create-once: unlike os.replace it
+        # cannot overwrite a receipt from another attempt.
+        os.link(temporary, path)
+        os.unlink(temporary)
+        _fsync_directory(parent)
+    except FileExistsError as error:
+        if not created_temporary:
+            raise RuntimeError(f"role GPU partition temporary path collision: {temporary}") from error
+        raise RuntimeError(f"role GPU partition receipt already exists: {path}") from error
+    finally:
+        if descriptor is not None:
+            os.close(descriptor)
+        if created_temporary and os.path.lexists(temporary):
+            os.unlink(temporary)
+    return complete
+
+
+def _collect_role_gpu_partition_receipt(
+    config: DictConfig,
+    actor_worker_group: Any,
+    teacher_workers: list[Any],
+) -> dict[str, Any]:
+    """Probe both prepared worker groups and publish the pre-model receipt."""
+    trainer_config = config.trainer
+    student_config = trainer_config.get("student_physical_gpus")
+    teacher_config = trainer_config.get("teacher_physical_gpus")
+    try:
+        student_physical_gpus = list(student_config)
+        teacher_physical_gpus = list(teacher_config)
+    except TypeError as error:
+        raise RuntimeError("role GPU partition lists are required") from error
+    if student_physical_gpus != [0, 1, 2, 3] or teacher_physical_gpus != [4, 5, 6, 7]:
+        raise RuntimeError("role GPU partition must be student 0-3 and teacher 4-7")
+    receipt_path = trainer_config.get("role_gpu_partition_receipt_path")
+    if not isinstance(receipt_path, str) or not os.path.isabs(receipt_path):
+        raise RuntimeError("role GPU partition receipt path must be an absolute string")
+
+    observations: list[dict[str, Any]] = []
+    # Actor/critic groups are often fused WorkerDict actors.  Their public
+    # method is rebound on RayWorkerGroup, while the raw actor handle exposes
+    # only the role-prefixed method.  Use the group dispatch path for students
+    # and raw handles for the standalone teacher rollout workers.
+    student_observations = actor_worker_group.get_role_gpu_observation()
+    for observation in student_observations:
+        record = dict(observation)
+        record["role"] = "student"
+        observations.append(record)
+    teacher_references = [worker.get_role_gpu_observation.remote() for worker in teacher_workers]
+    for observation in ray.get(teacher_references):
+        record = dict(observation)
+        record["role"] = "teacher"
+        observations.append(record)
+    validated = validate_role_gpu_partition(
+        observations,
+        student_physical_gpus=student_physical_gpus,
+        teacher_physical_gpus=teacher_physical_gpus,
+        require_gpu_uuid=True,
+    )
+    receipt_observations = []
+    for observation in validated["observations"]:
+        receipt_observations.append(
+            {
+                "role": observation["role"],
+                "rank": observation["rank"],
+                "pid": observation["pid"],
+                "node_id": observation["node_id"],
+                "ray_accelerator_ids": observation["ray_accelerator_ids"],
+                "cuda_visible_devices": observation["cuda_visible_devices"],
+                "physical_gpu": observation["physical_gpu"],
+                "gpu_uuid": observation["gpu_uuid"],
+            }
+        )
+    document = {
+        "schema_version": "verl_role_gpu_partition_v1",
+        "status": "passed_pre_model_role_gpu_partition",
+        "gate_phase": "before_any_model_initialization",
+        "receipt_path": receipt_path,
+        "expected": {"student": [0, 1, 2, 3], "teacher": [4, 5, 6, 7]},
+        "node_id": validated["node_id"],
+        "observations": receipt_observations,
+        "student_model_initialized": False,
+        "teacher_servers_launched": False,
+    }
+    return _write_role_gpu_partition_receipt(receipt_path, document)
+
+
+def _atomic_torch_save(payload: Any, path: str) -> None:
+    """torch.save to a same-directory temporary file before atomic publication."""
+    parent = os.path.dirname(path)
+    os.makedirs(parent, exist_ok=True)
+    temporary = os.path.join(parent, f".{os.path.basename(path)}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
+    try:
+        with open(temporary, "xb") as handle:
+            torch.save(payload, handle)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, path)
+        _fsync_directory(parent)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
