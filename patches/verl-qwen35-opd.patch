+    """Restore the sequence-ragged layout of multimodal position IDs.
+
+    TensorDict/TransferQueue reconstruction can infer the wrong ragged axis
+    for a batch of per-sample ``[rope_axes, seq_len]`` tensors, especially
+    when a data-parallel shard contains only one sample.  Such a tensor has
+    physical values ``[rope_axes, seq_len]`` but offsets ``[0, rope_axes]``.
+    Merely changing its private ``_ragged_idx`` to 2 makes the metadata
+    internally inconsistent; the next micro-batch split then truncates the
+    sequence to ``rope_axes`` tokens.
+
+    ``input_ids`` has an unambiguous one-dimensional jagged layout, so use its
+    offsets as the canonical per-sample sequence boundaries and rebuild the
+    position NestedTensor.  The fallback retains the old metadata-only repair
+    for callers that do not carry nested ``input_ids``.
+    """
+    if "position_ids" not in data.keys():
+        return
+
+    position_ids = data["position_ids"]
+    if not position_ids.is_nested or position_ids.dim() != 3:
+        return
+
+    input_ids = data.get("input_ids")
+    if not isinstance(input_ids, torch.Tensor) or not input_ids.is_nested:
+        position_ids._ragged_idx = 2
+        return
+
+    target_offsets = input_ids.offsets()
+    if torch.equal(position_ids.offsets(), target_offsets):
+        position_ids._ragged_idx = 2
+        return
+
+    target_lengths = target_offsets.diff().tolist()
+    total_tokens = int(target_offsets[-1].item())
+    axis_major_values = None
+
+    # Fast path for TransferQueue reconstruction.  Its inferred ragged axis
+    # can be wrong, but unbind still returns the original per-sample tensors.
+    try:
+        pieces = position_ids.unbind(dim=0)
+    except RuntimeError:
+        pieces = ()
+
+    if len(pieces) == len(target_lengths):
+        normalized_pieces = []
+        num_rope_axes = None
+        for piece, seq_len in zip(pieces, target_lengths, strict=True):
+            if piece.ndim != 2:
+                normalized_pieces = []
+                break
+            if piece.shape[-1] == seq_len:
+                normalized = piece
+            elif piece.shape[0] == seq_len:
+                normalized = piece.transpose(0, 1).contiguous()
+            else:
+                normalized_pieces = []
+                break
+            if num_rope_axes is None:
+                num_rope_axes = normalized.shape[0]
+            elif normalized.shape[0] != num_rope_axes:
+                normalized_pieces = []
+                break
+            normalized_pieces.append(normalized)
+        if normalized_pieces:
+            axis_major_values = torch.cat(normalized_pieces, dim=1)
+
+    # Consolidate/pickle can instead leave valid physical values while making
+    # unbind fail.  Recover directly by matching the canonical token count.
+    if axis_major_values is None:
+        values = position_ids.values()
+        if values.ndim == 2 and values.shape[1] == total_tokens:
+            axis_major_values = values
+        elif values.ndim == 2 and values.shape[0] == total_tokens:
+            axis_major_values = values.transpose(0, 1).contiguous()
+        else:
+            raise ValueError(
+                "Cannot align multimodal position IDs with input tokens: "
+                f"position_values_shape={tuple(values.shape)}, "
+                f"position_offsets={position_ids.offsets().tolist()}, "
+                f"input_offsets={target_offsets.tolist()}"
+            )
+
+    if axis_major_values.shape[0] not in (3, 4) or axis_major_values.shape[1] != total_tokens:
+        raise ValueError(
+            "Expected 3 or 4 position axes aligned to every input token, "
+            f"got position_values_shape={tuple(axis_major_values.shape)}, total_tokens={total_tokens}"
+        )
+
+    repaired = torch.nested.nested_tensor_from_jagged(values=axis_major_values, offsets=target_offsets)
+    repaired._ragged_idx = 2
