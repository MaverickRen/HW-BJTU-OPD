+        if isinstance(image, Image.Image):
+            return image.convert("RGB")
+        if isinstance(image, (str, os.PathLike)):
+            with Image.open(os.fspath(image)) as value:
+                return value.convert("RGB")
+        if isinstance(image, dict):
