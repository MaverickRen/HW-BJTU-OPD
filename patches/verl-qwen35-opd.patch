+def pack_position_ids(position_ids: torch.Tensor, total_tokens: int) -> torch.Tensor:
+    """Pack jagged position IDs without relying on NestedTensor shape metadata.
+
+    ``TensorDict.consolidate`` followed by serialization can lose the ragged
+    dimension metadata of a 3D NestedTensor.  In that case a multimodal
+    position tensor whose physical values are ``[num_rope_axes, total_tokens]``
+    may be reported with a different logical dimension.  Branching on
+    ``position_ids.dim()`` can consequently turn token-major values
+    ``[total_tokens, num_rope_axes]`` into ``[1, total_tokens, num_rope_axes]``.
+    Qwen-style M-RoPE models instead require axis-major packed position IDs:
+    ``[num_rope_axes, 1, total_tokens]``.
+
+    The physical values and the independently known token count are stable
+    across serialization, so use them to identify and normalize the layout.
+    Standard 1D position IDs are returned as ``[1, total_tokens]``.
+    """
+    if not position_ids.is_nested:
+        raise ValueError("pack_position_ids expects a jagged NestedTensor")
+    if not isinstance(total_tokens, int) or total_tokens <= 0:
+        raise ValueError(f"total_tokens must be a positive int, got {total_tokens!r}")
+
+    values = position_ids.values()
+    if values.ndim == 1:
+        if values.shape[0] != total_tokens:
+            raise ValueError(
+                "1D packed position IDs do not match input token count: "
+                f"values_shape={tuple(values.shape)}, total_tokens={total_tokens}"
+            )
+        return values.unsqueeze(0)
+
+    if values.ndim != 2:
+        raise ValueError(
+            "Packed position IDs must have physical values with one or two dimensions, "
+            f"got values_shape={tuple(values.shape)}"
+        )
+
+    if values.shape[1] == total_tokens:
+        axis_major_values = values
+    elif values.shape[0] == total_tokens:
+        axis_major_values = values.transpose(0, 1).contiguous()
+    else:
+        raise ValueError(
+            "Multimodal packed position IDs do not match input token count: "
+            f"values_shape={tuple(values.shape)}, total_tokens={total_tokens}"
+        )
+
+    num_rope_axes = axis_major_values.shape[0]
+    if num_rope_axes not in (3, 4):
+        raise ValueError(
+            "Expected 3 or 4 M-RoPE position axes after packing, "
+            f"got {num_rope_axes} from values_shape={tuple(values.shape)}"
+        )
+    return axis_major_values.unsqueeze(1)
