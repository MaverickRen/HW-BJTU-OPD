+def _normalize_explicit_save_steps(value: Any, total_training_steps: int) -> frozenset[int]:
+    """Validate optional exact checkpoint steps used by the v1 trainer.
+
+    ``save_freq`` remains fully backward compatible. ``trainer.save_steps``
+    is an opt-in list for experiments whose meaningful checkpoints do not
+    form one constant interval.
+    """
+
+    if value is None:
+        return frozenset()
+    if isinstance(value, (str, bytes)):
+        raise ValueError("trainer.save_steps must be a sequence of positive integers")
+    try:
+        raw_steps = list(value)
+    except TypeError as exc:
+        raise ValueError("trainer.save_steps must be a sequence of positive integers") from exc
+    steps: set[int] = set()
+    for raw in raw_steps:
+        if isinstance(raw, bool) or not isinstance(raw, int):
+            raise ValueError("trainer.save_steps must contain only integers")
+        if raw <= 0 or raw > total_training_steps:
+            raise ValueError(f"trainer.save_steps entry {raw} is outside [1, {total_training_steps}]")
+        steps.add(raw)
+    return frozenset(steps)
+
